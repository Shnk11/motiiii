<script>

function showPage(number) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById("page" + number).classList.add("active");

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* Falling flowers */

const petals = document.getElementById("petals");

const flowers = ["🌸", "🌷", "🌺", "💮", "💕"];

for (let i = 0; i < 35; i++) {

    const petal = document.createElement("div");

    petal.className = "petal";
    petal.innerHTML = flowers[Math.floor(Math.random() * flowers.length)];

    petal.style.left = Math.random() * 100 + "%";
    petal.style.animationDuration = (5 + Math.random() * 7) + "s";
    petal.style.animationDelay = Math.random() * 8 + "s";
    petal.style.fontSize = (15 + Math.random() * 15) + "px";

    petals.appendChild(petal);
}

</script>

