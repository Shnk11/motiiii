<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: "Poppins", sans-serif;
    background: linear-gradient(135deg, #ffb6d9, #ffd6e8, #ff9fc9);
    color: #7a1749;
    overflow-x: hidden;
}

.page {
    display: none;
    min-height: 100vh;
    padding: 35px 18px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.page.active {
    display: flex;
}

.card {
    width: min(900px, 95%);
    padding: 45px 30px;
    text-align: center;
    border-radius: 30px;
    background: rgba(255,255,255,0.35);
    border: 1px solid rgba(255,255,255,0.6);
    box-shadow: 0 20px 60px rgba(150, 35, 95, 0.2);
    backdrop-filter: blur(12px);
    animation: appear 1s ease;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(25px) scale(.97);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

h1 {
    font-family: "Great Vibes", cursive;
    font-size: clamp(55px, 10vw, 95px);
    color: #c21868;
    margin-bottom: 5px;
}

h2 {
    font-family: "Great Vibes", cursive;
    font-size: clamp(40px, 7vw, 65px);
    color: #c21868;
    margin-bottom: 20px;
}

.subtitle {
    font-size: clamp(20px, 4vw, 30px);
    font-weight: 600;
    color: #941653;
    margin-bottom: 25px;
}

.message {
    font-size: clamp(16px, 2.5vw, 20px);
    line-height: 1.9;
    background: rgba(255,255,255,0.35);
    padding: 25px;
    border-radius: 22px;
    margin: 25px auto;
    max-width: 760px;
}

.flowers {
    font-size: 55px;
    margin: 15px 0 25px;
    letter-spacing: 12px;
}

button {
    border: none;
    padding: 14px 28px;
    border-radius: 50px;
    background: linear-gradient(135deg, #e91e78, #b91363);
    color: white;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(185,19,99,.3);
    transition: .3s;
}

button:hover {
    transform: translateY(-3px) scale(1.03);
}

.love-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    max-height: 55vh;
    overflow-y: auto;
    padding: 10px;
    margin: 20px 0;
}

.love {
    padding: 13px;
    border-radius: 15px;
    background: rgba(255,255,255,.45);
    font-size: 14px;
    color: #781342;
}

.final {
    font-family: "Great Vibes", cursive;
    font-size: clamp(35px, 6vw, 60px);
    color: #c21868;
    margin: 25px 0;
}

.petals {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: -1;
}

.petal {
    position: absolute;
    top: -30px;
    font-size: 20px;
    animation: fall linear infinite;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(360deg);
    }
}

@media (max-width: 600px) {
    .card {
        padding: 35px 18px;
    }

    .message {
        padding: 18px;
        line-height: 1.7;
    }

    .flowers {
        font-size: 42px;
    }

    .love-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

